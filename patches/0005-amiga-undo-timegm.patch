@@ -40,6 +40,24 @@
 
 using namespace pugi;
 
+
+#ifdef __AMIGA__
+// the Amiga C library has no timegm: UTC broken-down time to seconds
+static time_t tmx_timegm(const struct tm *t)
+{
+    int y = t->tm_year + 1900, m = t->tm_mon + 1;
+    y -= m <= 2;
+    const long era = (y >= 0 ? y : y - 399) / 400;
+    const long yoe = y - era * 400;
+    const long doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + t->tm_mday - 1;
+    const long doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    const long days = era * 146097 + doe - 719468;
+    return (time_t)(days * 86400L + t->tm_hour * 3600L + t->tm_min * 60L + t->tm_sec);
+}
+#else
+#define tmx_timegm timegm
+#endif
+
