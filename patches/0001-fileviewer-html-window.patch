 }
 
@@ -437,6 +450,23 @@
 
 wxString FileToHTMLMarkup(const wxTextFile& file, const wxString& ext, size_t lineno)
 {
+#ifdef __WXOPENLAYOUT__
+    // wx's HTML window: no CSS or scripts; numbered lines, the one asked
+    // for in bold on a highlight, and an anchor to scroll to
+    (void)ext;
+    wxString page = "<html><body><table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\"><tr><td><pre>";
+    const size_t lines = file.GetLineCount();
+    for (size_t i = 0; i < lines; i++)
+    {
+        wxString num = wxString::Format("%5zu  ", i + 1);
+        if (i + 1 == lineno)
+            page += "</pre></td></tr><tr><td bgcolor=\"#fff3a0\"><a name=\"mark\"></a><pre><b>" + num + EscapeMarkup(file[i]) + "</b></pre></td></tr><tr><td><pre>";
+        else
+            page += num + EscapeMarkup(file[i]) + "\n";
+    }
+    page += "</pre></td></tr></table></body></html>";
+    return page;
+#endif
     wxString html = wxString::Format(
